# ---------------------------------------------------------------------------
# Bad'Trip — variables d'environnement
# Copie ce fichier en `.env.local` et remplis les valeurs (toutes gratuites).
# ---------------------------------------------------------------------------

# Supabase (comptes, base de données, stockage des fichiers)
# -> https://supabase.com  →  crée un projet  →  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Clé "service_role" de Supabase (SECRET, jamais exposée au navigateur).
# Sert côté serveur pour créer les invitations / lire les fichiers.
# -> Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Google Gemini (analyse des fichiers → itinéraire). Gratuit, sans carte.
# -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Modèle Gemini utilisé (le "flash" est gratuit et multimodal : texte + images + PDF)
GEMINI_MODEL=gemini-1.5-flash

# URL publique du site (sert pour les liens d'invitation). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
